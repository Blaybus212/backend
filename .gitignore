# Standard .gitignore for Java/Gradle/Spring Boot projects

### Build ###
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar

### IDE ###
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/
bin/

### OS ###
.DS_Store
Thumbs.db

### Logs ###
logs/
*.log

### Secrets & Credentials ###
# Production configuration (환경별 설정만 포함, 기밀 정보 없음)
# application-prod.yml은 더 이상 gitignore하지 않음

# local environment variables
**/.env
!.env.gpg  # 암호화된 .env 파일은 커밋 허용

# Keys and Certificates
*.jks
*.p12
*.key
*.pem